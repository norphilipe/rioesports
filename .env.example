# Supabase / Cloudflare runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled jobs
CRON_SECRET=
FACEIT_PROCESSOR_SECRET=

# FACEIT data API (FACEIT_SERVER_API_KEY is preferred; FACEIT_API_KEY is supported for compatibility)
FACEIT_SERVER_API_KEY=
FACEIT_API_KEY=

# FACEIT OAuth
FACEIT_OAUTH_CLIENT_ID=
FACEIT_OAUTH_CLIENT_SECRET=
FACEIT_OAUTH_REDIRECT_URI=https://rioesports.com.br/api/auth/faceit/callback

# Leetify public API (optional; unauthenticated requests work with stricter rate limits)
LEETIFY_API_KEY=

# FACEIT webhook verification
FACEIT_WEBHOOK_SECRET=
